#!/bin/bash
# Program OTP key 1 (the device-unique key the key ladder derives from), if it is blank. PERMANENT.
#
#   sudo rpi-aws-otp-init           dry run: says whether key 1 is programmed, and what --write would do
#   sudo rpi-aws-otp-init --write   programs key 1, after you type this board's serial to confirm
#
# If key 1 is already programmed (by rpi-sb-provisioner, Raspberry Pi Connect or an earlier run), this
# writes nothing. Otherwise --write runs "rpi-fw-crypto genkey --key-id 1 --alg ec": the firmware makes an
# EC P-256 key inside the SoC and stores it in OTP. It can never be erased or changed.
#
# On a Pi 5 or CM5 there is one such slot, and Raspberry Pi Connect uses the same key to sign in: that is
# fine (the key ladder only asks the firmware for an HMAC, which reveals nothing of the key), but it is the
# same key. In production, rpi-sb-provisioner programs this key; this script is for development boards.
set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }
write=0
case "${1:-}" in
  "") ;;
  --write) write=1 ;;
  -h|--help) sed -n '2,/^set /p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; exit 0 ;;
  *) die "usage: rpi-aws-otp-init [--write]" ;;
esac
[ "$(id -u)" -eq 0 ] || die "run with sudo"
command -v rpi-fw-crypto >/dev/null || die "rpi-fw-crypto is not installed (sudo apt install rpifwcrypto)"

status=$(/usr/local/sbin/rpi-aws-keyhelper status | sed -n 's/^otp-key-1: //p')
serial=$(tr -d '\0' < /proc/device-tree/serial-number)
model=$(tr -d '\0' < /proc/device-tree/model)
echo "Board:     $model, serial $serial"
echo "OTP key 1: $status"

if [ "$status" = programmed ]; then
  echo "Nothing to do: key 1 is already programmed, and this script never writes it again."
  exit 0
fi
[ "$status" = blank ] || die "could not read the state of OTP key 1"

cat <<EOF

--write would run:   rpi-fw-crypto genkey --key-id 1 --alg ec
This writes a key into this board's OTP. It is PERMANENT: it cannot be undone, erased or changed.
EOF
case "$model" in *"Pi 5"*|*"Compute Module 5"*)
  echo "This board has one key slot, which Raspberry Pi Connect also uses to sign in." ;;
esac
if [ "$write" -eq 0 ]; then
  echo "Dry run: nothing written. Run with --write to program it."
  exit 0
fi

read -r -p "Type this board's serial ($serial) to program OTP key 1, or anything else to stop: " answer
[ "$answer" = "$serial" ] || die "not confirmed; nothing written"
rpi-fw-crypto genkey --key-id 1 --alg ec
status=$(/usr/local/sbin/rpi-aws-keyhelper status | sed -n 's/^otp-key-1: //p')
echo "OTP key 1: $status"
[ "$status" = programmed ] || die "key 1 still reads as blank; restart the board and run this again (it will not write twice)"
